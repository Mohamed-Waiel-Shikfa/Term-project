        <mxCell id="sBBn_LDlDQh_kAXaMZRd-7" value="&lt;p class=&quot;MsoNormal&quot;&gt;Once the player is familiar with the context and the base mechanics&lt;br/&gt;of the game, the game and the story will actually start.&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;whiteSpace=wrap;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" parent="21ea969265ad0168-10" vertex="1">
